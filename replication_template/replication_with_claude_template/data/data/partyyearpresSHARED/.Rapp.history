t3c1<-my.spat3(form=this.mod, adj.matrix=adjMatShared, selector=c(!is.na(DruckData.Reduced$risk) & !is.na(DruckData.Reduced$newdist)) & DruckData.Reduced$incumbent == 0)#
#
### Table 3: Column 2 - incumbents#
