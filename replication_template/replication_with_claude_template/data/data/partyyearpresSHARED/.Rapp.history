help(geeglm)
TOFIAS NYHAN - CONGRESSIONAL NETWORKS-LEADERSHIP PROJECT##
#MARCH 2012##
#
# get modularity from cosponsorship networks using roll call vote clusters as partitions.#
#
#clear out the cruft#
rm(list = ls())#
#
#set directory automagically#
theDir<-getwd()#
if (regexpr("tof",theDir)!=-1)   setwd("/Users/tof/Dropbox/Projects/Member-to-member contributions/(4) analysis/")#
if (regexpr("nyhan",theDir)!=-1) setwd("/Users/brendannyhan/Documents/Dropbox/Member-to-member contributions/(4) analysis/")#
getwd() #prove it#
#
#file.remove("rc3clustermod.txt") #delete data file before re-running due to append command#
#
#load packages #
library(foreign)#
library(igraph0)#
library(gregmisc) #Load Permutation Library#
#
#initialize chamber#
senate<-0#
#
#chamber loop starter#
while (senate < 2) {#
if (senate==1){chmbr<-"h"} else{chmbr<-"s"}#
if (senate==1){chamber<-"house"} else{chamber<-"senate"}#
#
#initialize party#
partyid<-100#
party<-"d"#
#
#party loop starter#
while (partyid < 201) {#
#
#initialize year#
year <- 1986#
#
while (year < 2007) {#
#
edgelocal<-paste("igraph.",chmbr,".",partyid,".",year,".ncol" ,sep="")#
g <- read.graph(edgelocal, format="ncol", directed="true")#
#
nodelocal<-paste("ideofac3-nodes-",chamber,"-",partyid,".",year,".dta",sep="")#
nodes<- read.dta(nodelocal)#
#
#ATTACH some node attributes#
i = 0#
while (i < length(V(g))) {#
#
theidno <- V(g)[i]$name#
#
j=1#
while (j <= length(nodes$ideofact) ) {#
#
if (theidno == nodes$idno[j]){#
#
V(g)[i]$ideofact<-nodes$ideofact[j]#
#
j = 500#
}#
#
j = j + 1#
}#
i = i +1#
}#
#CALCULATE MODULARITY SCORES for the roll call cluster partitions #
#
ideomod <- modularity(g, V(g)$ideofact, weights = E(g)$weight)#
match <- length(nodes$ideofact)==length(V(g))#
#
refideomod<-rep(NA,length=1000)#
nperms<-1000#
#
for(mm in 1:nperms){#
factions<-V(g)$ideofact#
fakefactions<-sample(factions) #Permute Group Assignments#
refideomod[mm]<-modularity(g, fakefactions, weights = E(g)$weight) #Modularity with Random assignment#
}#
#
minfakemod<-min(refideomod)#
maxfakemod<-max(refideomod)#
fakemod025<-quantile(refideomod,.025)#
fakemod975<-quantile(refideomod,.975)#
fakemod005<-quantile(refideomod,.005)#
fakemod995<-quantile(refideomod,.995)#
#
#WRITE OUTPUT#
ideomoddata<-cbind(senate,partyid,year,ideomod,match,minfakemod,maxfakemod,fakemod025,fakemod975,fakemod005,fakemod995)#
write.table(ideomoddata,file="rc3clustermod.txt",append=TRUE,col.names=FALSE) #
rm(ideomoddata)#
#
#year loop ender#
year<-year+2#
}#
#party loop ender#
partyid<-partyid+100#
party<-"r"#
}#
#chamber loop ender#
senate<-senate+1#
chmbr<-"s"#
}#
#
#end script
partyid
year
edgelocal<-paste("igraph.",chmbr,".",partyid,".",year,".ncol" ,sep="")#
g <- read.graph(edgelocal, format="ncol", directed="true")
