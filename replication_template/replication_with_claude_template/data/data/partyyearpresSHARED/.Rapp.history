a2Out[37,3]<-a2c3$LR1[[1]][[1]]#
a2Out[38,3]<-a2c3$LR1[[3]][[1]]#
a2Out[39,3]<-length(a2c3$fitted.values)#
a2Out[c(seq(1, 7*2, by=2), seq(10*2-1, 17*2, by=2)) ,4]<-(a2c4$coefficients)#
a2Out[c(seq(2, 7*2, by=2), seq(10*2, 17*2, by=2)) ,4]<-a2c4$rest.se#
a2Out[35,4]<-  a2c4$rho#
a2Out[36,4]<- a2c4$rho.se#
a2Out[37,4]<-a2c4$LR1[[1]][[1]]#
a2Out[38,4]<-a2c4$LR1[[3]][[1]]#
a2Out[39,4]<-length(a2c4$fitted.values)#
a2Out#
(xtable(a2Out, digits=3))
