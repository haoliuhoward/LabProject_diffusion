#JMM TO REVISE#
# Jmm Revision on 9-11#
#BJN fixed#
# Jmmm Complete revision for new results 11/28#
#
#setwd("/Users/bnyhan/Downloads")#
setwd("/Users/bnyhan/Documents/Dropbox/Consultant data analysis/Clean data folder/data/")#
#setwd("~/Dropbox/Consultant data analysis (1)/Clean data folder/data/")#
library(spdep)#
library(foreign)#
library(spatialprobit)#
library(xtable)#
options(digits=10)#
#
## Different adjacency matrices #
adjMatLog <- read.dta("allCand-log-after-proj.dta") #logged dolllars#
adjMatLog<-as.matrix(adjMatLog, rownames.force = FALSE)#
adjMatBin <- (adjMatLog>0)*1 #binary#
adjMatShared<- read.dta("allCand-shared-cons.dta") #Count of shared consultants#
adjMatShared <- as.matrix(adjMatShared, rownames.force = FALSE)#
#
## Read in the data#
DruckData <- read.dta("DruckmanFinal2.dta")#
#
## Make some additional needed variables#
DruckData$democrat04 <- DruckData$y2004*DruckData$democrat#
DruckData$democrat06 <- DruckData$y2006*DruckData$democrat#
#
attach(DruckData)#
region<-NA#
region[statename=="Maine" | statename=="Massachusetts" | statename=="New Hampshire" | statename=="Rhode Island" | statename=="Vermont"] <- 0#
region[statename=="Connecticut" | statename=="Delaware" | statename=="New Jersey" | statename == "New York" | statename=="Pennsylvania"] <- 1#
region[statename=="Illinois" | statename=="Indiana" | statename=="Michigan" | statename=="Ohio" | statename=="Wisconsin"] <- 2#
region[statename=="Iowa" | statename == "Kansas" | statename=="Minnesota" | statename=="Nebraska" | statename=="South Dakota" | statename=="North Dakota"] <- 3#
region[statename=="Alabama" | statename == "Arkansas" | statename == "Florida"| statename == "Georgia" | statename=="Louisiana" | statename=="Mississippi" | statename=="North Carolina" | statename=="South Carolina" | statename=="Texas" | statename=="Virginia"] <- 4#
region[statename=="Kentucky" | statename=="Maryland" | statename == "Missouri" | statename=="Oklahoma" | statename=="Tennessee" | statename=="West Virginia"] <- 5#
region[statename=="Arizona" | statename=="Colorado" | statename=="Idaho" | statename == "Montana" | statename=="Nevada" | statename=="New Mexico" | statename=="Utah" | statename=="Wyoming"] <- 6#
region[statename=="California" | statename=="Oregon" | statename=="Washington"] <- 7#
region[statename=="Alaska"| statename == "Hawaii"] <- 7#
detach(DruckData)#
DruckData$region <- region#
#
DruckData$newdist <- DruckData$disrepvote#
DruckData$newdist[DruckData$democrat==1] <- 100-DruckData$newdist[DruckData$democrat==1]#
#
#Make a version of newdist that is categorical#
newdistAlt <- rep(0, nrow(DruckData))#
newdistAlt[DruckData$newdist<=51&DruckData$newdist>42] <- 1#
newdistAlt[DruckData$newdist<=59&DruckData$newdist>51] <- 2#
newdistAlt[DruckData$newdist>59] <- 3#
DruckData$newdistAlt <- newdistAlt#
#
# Incumebnt#
DruckData$incumbent <- 1#
DruckData$incumbent[DruckData$chall==1 | DruckData$open==1]<-0#
#
varselection <- c("y2004", "y2006", "democrat", "democrat04",#
                  "democrat06", "chall", "open", "female",#
                  "disrepvote", "senate", "isssal2", "demdisrepvote",#
                  "oppgoneg", "fraised2", "goneg", "negperson",#
                  "negiss", "risk", "issueowner", "bioreason",#
                  "biooccup", "biofamil2", "poll", "cooks", "bioorg", "biotown",#
                  "positions", "endorse", "partybann","cfscore",#
                  "region", "incumbent", "newdist", "newdistAlt")#
#
DruckData.Reduced <- DruckData[,varselection]#
my.spat3<-function(form, adj.matrix , data = DruckData.Reduced, selector){#
  form=this.mod#
  startlist<-adj.matrix#
  dataset<-data#
  startlist0<-startlist[selector, selector]#
  final.list<-mat2listw(startlist0, style="W")#
#  final.list <- nb2listw(final.list, glist=NULL, style="W", zero.policy=TRUE)#
  final.data<-dataset[selector,]#
  (summary(#
           lagsarlm(form, data=final.data, listw=final.list, zero.policy=TRUE)#
           )#
   )#
}#
#
#JACOB MESSING AROUND HERE#
#str((mat2listw(adjMatShared)))#
#
#final.data<-dataset[selector,]#
#
#mat2listw(adjMatShared, style="W")$weights[[543]]#
#mat2listw(adjMatBin, style="W")$weights[[543]]#
#mat2listw(adjMatLog, style="W")$weights[[543]]#
#nb2listw(mat2listw(adjMatLog)$neighbour, glis=NULL, style="W", zero.policy=TRUE)$weights[[543]]#
#nb2listw(mat2listw(adjMatBin)$neighbour, glis=NULL, style="W", zero.policy=TRUE)$weights[[543]]#
#
                                        # Main results#
#
### Table 1: Column 1 #
this.mod <- risk ~ y2004 + y2006 + democrat +  open + chall + factor(newdistAlt)+ factor(region) #
t1c1<-my.spat3(form=this.mod, adj.matrix=adjMatShared, selector=c(!is.na(DruckData.Reduced$risk) & !is.na(DruckData.Reduced$newdist)))#
t1c1#
#
### Table 1: Column 2 #
this.mod <- risk ~ y2004 + y2006 + democrat +  open + chall + factor(newdistAlt)+ factor(region) + cfscore#
t1c2<-my.spat3(form=this.mod, adj.matrix=adjMatShared, selector=c(!is.na(DruckData.Reduced$risk) & !is.na(DruckData.Reduced$newdist) & !is.na(DruckData.Reduced$cfscore)))#
t1c2#
#
### Table 1: Column3#
this.mod <- issueowner ~ y2004 + y2006 + democrat + open + chall +   factor(newdistAlt) + factor(region) + isssal2#
t1c3<-my.spat3(form=this.mod, adj.matrix=adjMatShared, selector=c(!is.na(DruckData.Reduced$issueowner) & !is.na(DruckData.Reduced$newdist)))#
t1c3#
#
### Table 1: Column4#
this.mod <- issueowner ~ y2004 + y2006 + democrat + open + chall +   factor(newdistAlt) + factor(region) + cfscore + isssal2 + cfscore#
t1c4<-my.spat3(form=this.mod, adj.matrix=adjMatShared, selector=c(!is.na(DruckData.Reduced$issueowner) & !is.na(DruckData.Reduced$newdist) & !is.na(DruckData.Reduced$cfscore)))#
t1c4#
t1Out<-matrix(NA, nrow=18*2+5, ncol=4)#
#
t1Out[seq(1, 16*2, by=2) ,1]<-(t1c1$coefficients)#
t1Out[seq(2, 16*2, by=2) ,1]<-t1c1$rest.se#
t1Out[37,1]<-  t1c1$rho#
t1Out[38,1]<- t1c1$rho.se#
t1Out[39,1]<-t1c1$LR1[[1]][[1]]#
t1Out[40,1]<-t1c1$LR1[[3]][[1]]#
t1Out[41,1]<-length(t1c1$fitted.values)#
t1Out[seq(1, 17*2, by=2) ,2]<-(t1c2$coefficients)#
t1Out[seq(2, 17*2, by=2) ,2]<-t1c2$rest.se#
t1Out[37,2]<-  t1c2$rho#
t1Out[38,2]<- t1c2$rho.se#
t1Out[39,2]<-t1c2$LR1[[1]][[1]]#
t1Out[40,2]<-t1c2$LR1[[3]][[1]]#
t1Out[41,2]<-length(t1c2$fitted.values)#
rownames(t1Out)<-1:41#
rownames(t1Out)[seq(1, 18*2, by=2)]<-  rownames(t1c4$Coef)#
rownames(t1Out)[37]<-"rho"#
rownames(t1Out)[38]<-"asymp.se"#
rownames(t1Out)[39]<-"LR.stat"#
rownames(t1Out)[40]<-"p-value"#
rownames(t1Out)[41]<-"N"#
t1Out[c(seq(1, 16*2, by=2), 35)  ,3]<-(t1c3$coefficients)#
t1Out[c(seq(2, 16*2, by=2),36) ,3]<-t1c3$rest.se#
t1Out[37,3]<-  t1c3$rho#
t1Out[38,3]<- t1c3$rho.se#
t1Out[39,3]<-t1c3$LR1[[1]][[1]]#
t1Out[40,3]<-t1c3$LR1[[3]][[1]]#
t1Out[41,3]<-length(t1c3$fitted.values)#
t1Out[seq(1, 18*2, by=2) ,4]<-(t1c4$coefficients)#
t1Out[seq(2, 18*2, by=2) ,4]<-t1c4$rest.se#
t1Out[37,4]<-  t1c4$rho#
t1Out[38,4]<- t1c4$rho.se#
t1Out[39,4]<-t1c4$LR1[[1]][[1]]#
t1Out[40,4]<-t1c4$LR1[[3]][[1]]#
t1Out[41,4]<-length(t1c4$fitted.values)#
t1Out#
(xtable(t1Out, digits=3))
