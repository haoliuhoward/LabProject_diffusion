library(sem)#
library(AER)#
#
N <- 1670#
z <- rnorm(N)#
u <- rnorm(N) #
x <- 1 + z + u + rnorm(N) # x is correlated with the error term u (endogeneity) and the instrument z#
y <- 1 + x + u#
iv2 <- tsls(y  ~ x, instruments = ~ z)#
summary(iv2)
